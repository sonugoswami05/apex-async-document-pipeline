<?xml version="1.0" encoding="UTF-8"?>
<!--
    Template only. No secret lives in source control.
    After deploying, open Setup > Named Credentials > External Credentials > Doc Classifier Auth,
    edit the DefaultGroup principal and add an authentication parameter named ApiKey.
    The Authorization header below is built from that parameter at callout time.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>API key authentication for the document classification service.</description>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>DefaultGroup</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!'Bearer ' &amp; $Credential.Doc_Classifier_Auth.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Doc Classifier Auth</label>
</ExternalCredential>
